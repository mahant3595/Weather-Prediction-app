<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/forecast_day_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day 1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1E1E2C" />

            <TextView
                android:id="@+id/forecast_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Condition: Sunny"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/forecast_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24.5 °C"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#2196F3" />

            <TextView
                android:id="@+id/forecast_humidity_precip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hum: 55% | Rain: 10%"
                android:textSize="11sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
