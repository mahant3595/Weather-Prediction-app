<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <!-- Transparent Background Watermark App Logo -->
    <ImageView
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_sun_cloud_logo"
        android:alpha="0.06"
        android:contentDescription="@string/app_name" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Custom Top App Header Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_sun_cloud_logo"
                            android:contentDescription="@string/app_name"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sky_predict_ai"
                            android:textColor="#1E1E2C"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end" />

                        <Button
                            android:id="@+id/btn_nav_history"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="History"
                            android:textColor="#1E1E2C"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_nav_settings"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Settings"
                            android:textColor="#1E1E2C"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Search & Selection Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#1E1E2C">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Header Row: Select City + Temp Unit Selector -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/select_city"
                                android:textStyle="bold"
                                android:textColor="#00E676"
                                android:textSize="16sp" />

                            <RadioGroup
                                android:id="@+id/home_unit_radio_group"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <RadioButton
                                    android:id="@+id/home_radio_celsius"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/unit_celsius"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    android:checked="true" />

                                <RadioButton
                                    android:id="@+id/home_radio_fahrenheit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/unit_fahrenheit"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp" />
                            </RadioGroup>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <AutoCompleteTextView
                                android:id="@+id/city_search_input"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/search_city_hint"
                                android:textColor="#FFFFFF"
                                android:textColorHint="#AAAAAA"
                                android:inputType="textPostalAddress"
                                android:completionThreshold="1"
                                android:maxLines="1"
                                android:textSize="16sp" />

                            <Button
                                android:id="@+id/search_button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/go_button"
                                android:backgroundTint="#00E676"
                                android:textColor="#1E1E2C"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Or select from 100+ cities list (Search above if not listed):"
                            android:textSize="12sp"
                            android:textColor="#CCCCCC"
                            android:layout_marginBottom="4dp"/>

                        <Spinner
                            android:id="@+id/city_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Quick Search History Chips Container -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/chips_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Current City Weather Display Card (Dark Contrast Styling with Condition Watermark & Advisory Badge) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/current_weather_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#1E1E2C">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_toStartOf="@id/card_weather_watermark">

                            <TextView
                                android:id="@+id/current_city_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="City: None"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:layout_marginBottom="12dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/current_weather"
                                android:textStyle="bold"
                                android:textColor="#00E676"
                                android:textSize="16sp"
                                android:layout_marginBottom="8dp"/>

                            <TextView
                                android:id="@+id/current_temp_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Temperature: --"
                                android:textSize="16sp"
                                android:textColor="#FFFFFF"
                                android:layout_marginBottom="4dp"/>

                            <TextView
                                android:id="@+id/current_humidity_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Humidity: --"
                                android:textSize="16sp"
                                android:textColor="#FFFFFF"
                                android:layout_marginBottom="4dp"/>

                            <TextView
                                android:id="@+id/current_precip_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Precipitation Prob: --"
                                android:textSize="16sp"
                                android:textColor="#FFFFFF"
                                android:layout_marginBottom="10dp" />

                            <!-- Weather Advisory Badge -->
                            <TextView
                                android:id="@+id/weather_advisory_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="☀️ Ideal Outdoor Conditions"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:background="#2E7D32"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/card_weather_watermark"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:src="@drawable/ic_watermark_sun"
                            android:alpha="0.35"
                            android:contentDescription="@string/app_name" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- AI Forecast Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ai_forecast_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#1E1E2C">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weather_prediction"
                            android:textStyle="bold"
                            android:textColor="#00E676"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/predicted_temp_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Predicted Temp: --"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:id="@+id/predicted_humidity_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Predicted Humidity: --"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="6dp"/>

                        <TextView
                            android:id="@+id/predicted_precip_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Predicted Precip Prob: --"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="12dp" />

                        <Button
                            android:id="@+id/btn_view_prediction_charts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/view_forecast_charts_btn"
                            android:backgroundTint="#00E676"
                            android:textColor="#1E1E2C"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <Button
                            android:id="@+id/btn_share_home"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Share Weather Forecast"
                            android:backgroundTint="#00E676"
                            android:textColor="#1E1E2C"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Recent Cities History Card -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_cities"
                    android:textStyle="bold"
                    android:textColor="#1E1E2C"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/recent_history_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</FrameLayout>
