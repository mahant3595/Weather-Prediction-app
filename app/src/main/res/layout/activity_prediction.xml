<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <!-- Transparent Background Watermark Logo -->
    <ImageView
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_sun_cloud_logo"
        android:alpha="0.08"
        android:contentDescription="@string/app_name" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Header Row with Top-Left Back Arrow and Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/btn_back_arrow"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="@string/back_to_home" />

                <TextView
                    android:id="@+id/prediction_header_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/prediction_screen_title"
                    android:textColor="#1E1E2C"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Selected City Info -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1E1E2C">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/prediction_city_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="City: New York"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/prediction_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Local Regression Engine: Active"
                        android:textColor="#00E676"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 24-Hour AI Forecast Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Next 24-Hour AI Prediction"
                        android:textColor="#1E1E2C"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/pred_temp_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Predicted Temp: --"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/pred_humidity_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Predicted Humidity: --"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/pred_precip_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Predicted Precip Prob: --"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/pred_condition_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expected Condition: Sunny"
                        android:textColor="#2196F3"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 7-Day AI Forecast Summary Container -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7-Day AI Multi-Day Forecast"
                android:textColor="#1E1E2C"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/multi_day_forecast_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp" />

            <!-- View Charts Action Button -->
            <Button
                android:id="@+id/view_charts_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_detailed_charts_btn"
                android:backgroundTint="#1E1E2C"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
