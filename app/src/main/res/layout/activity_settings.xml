<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB">

    <!-- Transparent Background Watermark Logo -->
    <ImageView
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_sun_cloud_logo"
        android:alpha="0.08"
        android:contentDescription="@string/app_name" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Top Header Row with Top-Left Back Arrow and Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/btn_back_arrow"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="@string/back_to_home" />

                <TextView
                    android:id="@+id/settings_header_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_screen_title"
                    android:textColor="#1E1E2C"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 1: App Overview (Dark Contrast Style) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1E1E2C">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/project_info_header"
                        android:textColor="#00E676"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/project_info_desc"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Default Startup City -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1E1E2C">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Default Startup City"
                        android:textColor="#00E676"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Set your preferred city to show automatically whenever you open the app:"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp" />

                    <AutoCompleteTextView
                        android:id="@+id/input_default_city"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter default city name..."
                        android:textColor="#FFFFFF"
                        android:textColorHint="#AAAAAA"
                        android:inputType="textPostalAddress"
                        android:completionThreshold="1"
                        android:maxLines="1"
                        android:textSize="16sp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btn_save_default_city"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save Default City"
                        android:backgroundTint="#00E676"
                        android:textColor="#1E1E2C"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Report Missing City / Feedback -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="72dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#1E1E2C">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Report Missing City"
                        android:textColor="#00E676"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Let us know if your city is not available or share your feedback:"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/input_report_message"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:hint="Enter missing city name or feedback..."
                        android:textColor="#FFFFFF"
                        android:textColorHint="#AAAAAA"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:maxLines="5"
                        android:textSize="14sp"
                        android:background="@drawable/placeholder"
                        android:padding="8dp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btn_submit_report"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Submit Report"
                        android:backgroundTint="#00E676"
                        android:textColor="#1E1E2C"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Circular Share FloatingActionButton in Bottom-Left Corner with Margins (Higher up) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="36dp"
        android:src="@drawable/ic_share"
        android:contentDescription="@string/share_weather_btn"
        app:backgroundTint="#1E1E2C"
        app:tint="#FFFFFF"
        app:fabSize="normal" />

</FrameLayout>
