<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeatherPredictionApp">
        <activity
            android:name="com.example.weatherprediction.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.WeatherPredictionApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.weatherprediction.HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.WeatherPredictionApp"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.weatherprediction.PredictionActivity"
            android:exported="false"
            android:label="@string/title_activity_prediction"
            android:theme="@style/Theme.WeatherPredictionApp" />

        <activity
            android:name="com.example.weatherprediction.DetailsActivity"
            android:exported="false"
            android:label="@string/title_activity_details"
            android:theme="@style/Theme.WeatherPredictionApp" />

        <activity
            android:name="com.example.weatherprediction.HistoryActivity"
            android:exported="false"
            android:label="@string/title_activity_history"
            android:theme="@style/Theme.WeatherPredictionApp" />

        <activity
            android:name="com.example.weatherprediction.SettingsActivity"
            android:exported="false"
            android:label="@string/title_activity_settings"
            android:theme="@style/Theme.WeatherPredictionApp" />

        <activity
            android:name="com.example.weatherpredictionapp.MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.WeatherPredictionApp" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>